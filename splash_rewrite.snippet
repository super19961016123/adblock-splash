# =========================================================
# 开屏广告 rewrite 配合规则（QuantumultX [rewrite_local]）
# 说明：域名规则拦不到「广告与内容同域名下发」的开屏广告，
#       本文件用 URL 正则对广告接口直接 reject，作为补充。
# 来源：社区公开规则（fmz200/wool_scripts、chxm1023/Advertising 等），
#       已标注出处；接口路径会变，请配合定期更新 + 订阅维护中的社区资源。
# =========================================================

[rewrite_local]

# ---------- 穿山甲（Pangle）广告接口 ----------
# 来源：chxm1023/Advertising
^https?:\/\/api-access\.pangolin-sdk-toutiao[-\w]*\.com\/.* url reject

# ---------- 优量汇 / 广点通 广告接口 ----------
# 来源：chxm1023/Advertising
^https?:\/\/(.*\.gdt\.qq\.com\/(gdt_mview.*|server_bidding)|adsmind\.gdtimg\.com\/ads_svp_video.*|pgdt\.gtimg\.cn) url reject-200

# ---------- 酷安 App 开屏广告（广点通 SDK，返回空广告让其跳过） ----------
# 酷安开屏广告组件：com.qq.e.ads.ADActivity，走 sdk.e.qq.com / gdt 接口
# 用 reject-200 返回空响应，SDK 判定无广告后立即跳过，避免空白等待
^https?:\/\/sdk\.e\.qq\.com\/.* url reject-200
^https?:\/\/.*\.gdt\.qq\.com\/.* url reject-200

# ---------- 阿里系 App 开屏 ----------
# 来源：chxm1023/Advertising（acs.m.taobao.com 为淘宝/天猫等开屏广告主接口）
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wmlayer\.adi\.load url reject-200

# ---------- 京东系 App 开屏 ----------
# 来源：fmz200/wool_scripts
# 京东读书 开屏/弹窗
^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/channel\/module\/opens url reject-200
^https?:\/\/jdread-api\.jd\.com\/jdread\/api\/popup url reject-200
# 京东云无线宝 开屏
^https?:\/\/router-app-api\.jdcloud\.com\/v\d\/board\/routerAppSplash url reject-200

# ---------- 通用聚合（穿山甲 GroMore 等聚合中间层） ----------
# 来源：chxm1023/Advertising
^https?:\/\/[-\w]*\.gromore\.com\/.* url reject-200

# ---------- 阿里系更多开屏接口（补充） ----------
# 来源：chxm1023/Advertising
^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.(cainiao\.adx\.flyad\.getad|taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get)) url reject-dict

# ---------- 京东金融 开屏 ----------
# 来源：chxm1023/Advertising
^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/aladdin\/newna\/m\/getLoadingPicture url reject-200

# ---------- 豆瓣 开屏广告 ----------
# 来源：chxm1023/Advertising
^https?:\/\/api\.douban\.com\/.+\/.*ads url reject-200

# ---------- 百度系 开屏广告接口 ----------
# 来源：chxm1023/Advertising
^https?:\/\/mime\.baidu\.com\/v\d\/(activity\/advertisement|start_screen_ads\/list) url reject-dict
^https?:\/\/bgg\.baidu\.com\/bgg\/produce url reject-dict

# ---------- 酷狗概念版 开屏广告 ----------
# 来源：chxm1023/Advertising
^https?:\/\/gateway\.kugou\.com\/(youth\/v\d\/(ad\/play_status.+|start_img\/get_set|ab\/tmeab.+)|ads.+) url reject-dict

# ---------- 网速管家 开屏 ----------
# 来源：chxm1023/Advertising
^https?:\/\/.*\.speedtest\.cn\/(images|api\/.+\/showpic\/position) url reject-200

# ---------- 掌上公交 广告 ----------
# 来源：chxm1023/Advertising
^https?:\/\/remind\.mygolbs\.com\/remind-off\/query\/.+ url reject
^https?:\/\/.*\.enmonster\.com\/apa\/(advert\/demand\/home\/poster|index\/advert\/skin) url reject-dict

# ---------- 微博开屏广告 ----------
# 来源：PakandAlive/Weibo Remove Ads.plugin、zwf234/tailadv.conf、fmz200/wool_scripts
# 微博开屏走 uve.weibo.com 域，接口需返回空广告（reject-dict）让其跳过
^https:\/\/(?:bootrealtime|bootpreload)\.uve\.weibo\.com\/v\d\/ad\/(?:realtime|preload) url reject-dict
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:sdkad\.php|get-lbs-cell-info\.php|sdkconfig\.php) url reject-dict
^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua) url reject-dict
^https?:\/\/(?:sdk|wb)app\.uve\.weibo\.com\/(?:interface\/sdk\/sdkad\.php|wbapplua\/wbpullad\.lua) url reject-dict
# 微博信息流/推送广告接口
^https?:\/\/api\.weibo\.cn\/2\/(?:ad\/preload|push\/active|client\/addlog_batch) url reject-dict

# ---------- 酷安 App 开屏广告 ----------
# 来源：酷安隐私政策（集成穿山甲、优量汇、快手、GroMore、ADmobile、米盟 SDK）
# 域名规则已覆盖上述第三方 SDK；这里补酷安 SDK 竞价接口
# 注意：api.coolapk.com/v6/main/indexV8 是「首页头条内容 + 开屏广告」混合接口，
#       整条 reject-dict 会把酷安内部"头条"内容一起清空导致黑屏，不可整条拦（2026-11-04 移除）。
#       酷安开屏改为只拦下方纯广告的第三方 SDK 竞价接口，自家开屏暂无法干净去除。
# 酷安第三方 SDK 竞价接口（穿山甲/优量汇/快手聚合，纯广告接口，返回空广告跳过）
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk url reject
^https?:\/\/mi\.gdt\.qq\.com\/gdt_mview\.fcg url reject
^https?:\/\/open\.e\.kuaishou\.com\/rest\/e\/v3\/open\/univ url reject

# 下面字段：列出上述 rewrite 覆盖的主机（供 QuantumultX 快速匹配，非必须）
hostname = api-access.pangolin-sdk-toutiao*.com, *.gdt.qq.com, sdk.e.qq.com, adsmind.gdtimg.com, pgdt.gtimg.cn, acs.m.taobao.com, guide-acs.m.taobao.com, jdread-api.jd.com, router-app-api.jdcloud.com, ms.jr.jd.com, api.douban.com, mime.baidu.com, bgg.baidu.com, gateway.kugou.com, *.speedtest.cn, *.mygolbs.com, *.enmonster.com, *.gromore.com, *.uve.weibo.com, api.weibo.cn, api.coolapk.com, *.pangolin-sdk-toutiao.com, mi.gdt.qq.com, open.e.kuaishou.com

# =========================================================
# 强烈建议：再订阅下列「持续维护」的社区全量 rewrite 资源，
# 覆盖面远大于本文件示例，且接口更新及时：
#   · fmz200/wool_scripts  QuantumultX/rewrite/rewrite.snippet
#     https://raw.githubusercontent.com/fmz200/wool_scripts/main/QuantumultX/rewrite/rewrite.snippet
#   · chxm1023/Advertising（Loon/Surge，可转 QuantumultX 使用）
#     https://raw.githubusercontent.com/chxm1023/Advertising/main/Advertising.plugin
# 将以上链接按本说明「资源」方式添加到 QuantumultX 即可自动更新。
# =========================================================
